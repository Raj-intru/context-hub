# Copy to .env and fill in ONE provider. You type this, never the agent.
# Leave it all blank and the app uses the browser's own voice — the demo
# still works, it just sounds like a satnav.

VOICE_PROVIDER=cartesia

# Cartesia — cheapest commercial entry, lowest latency. ~20k free credits/month.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-2

# ElevenLabs — best known, most expensive per character.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# OpenAI — no subscription, pay a fraction of a cent for this demo's lines.
OPENAI_API_KEY=
OPENAI_VOICE=alloy
