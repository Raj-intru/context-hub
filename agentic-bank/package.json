{
  "name": "agentic-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent-first bank: a deterministic banking kernel with an agent layer on top, serving consumer, business and institutional customers over one mobile- and API-first surface.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.mjs",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
