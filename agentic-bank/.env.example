# ---------------------------------------------------------------------------
# agentic-bank configuration
# ---------------------------------------------------------------------------

# Store backend. "memory" (default) keeps everything in-process: fine for the
# demo, the test suite and local development. "postgres" is the only backend
# that should ever see a real balance.
STORE=memory
DATABASE_URL=postgres://agentic_bank@localhost:5432/agentic_bank

PORT=5100

# Signs the session/API tokens the demo issues. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Agent layer
# ---------------------------------------------------------------------------
# AGENT_PROVIDER: "anthropic" | "stub".
# "stub" is a deterministic, offline planner used by the tests and by the demo
# when no key is present. It never reaches the network.
AGENT_PROVIDER=stub
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
AGENT_MAX_STEPS=8

# ---------------------------------------------------------------------------
# Controls
# ---------------------------------------------------------------------------
# Screening provider for counterparties/payments. "stub" uses the local
# denylist in src/kernel/screening.js. There is no "off" setting: screening
# fails closed.
SCREENING_PROVIDER=stub

# Cut-off times are evaluated in this zone (IANA name).
BANK_TIMEZONE=Australia/Sydney
